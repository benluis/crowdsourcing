# Copy to .env and fill in your values. Never commit .env.

# Gemini vision API (https://ai.google.dev/) — used for Kicktraq chart extraction
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_TOKENS=4096
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_DELAY_SECONDS=2.0

# Kicktraq pipeline defaults (optional overrides)
KICKTRAQ_CHARTS_DIR=data/kicktraq/charts
KICKTRAQ_DB_PATH=data/kickstarter/kickstarter_YYYYMMDD.db
